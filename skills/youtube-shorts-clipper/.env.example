# Copy this file to .env and fill in YOUR OWN keys.
# Never share this file, never paste it in chat, never push it to GitHub.

# Optional: Gemini re-rank of hook candidates (get a free key at
# https://aistudio.google.com/ -> "Get API key").
GEMINI_API_KEY=

# Path to your YouTube OAuth client secrets (see SETUP.md step 5).
# If empty, upload.py looks for ./client_secrets.json first.
YT_CLIENT_SECRETS=
